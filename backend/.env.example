# Server
NODE_ENV=development
PORT=3001
# Public backend URL (no trailing slash). Production: https://api.your-domain.com
API_BASE_URL=http://localhost:3001

# Database (PostgreSQL — Docker: port 5433, local postgres ho to 5432)
DATABASE_URL=postgresql://smc:password@localhost:5433/smc_db

# Redis (optional — queue Phase 4 mein)
REDIS_URL=redis://localhost:6379

# JWT / Auth
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
TOKEN_ENCRYPTION_KEY=change-this-to-32-byte-hex-key

# AWS S3 — IAM > smc-backend > Security credentials > Create access key
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=smc-hamza-media
AWS_S3_PUBLIC_URL=https://smc-hamza-media.s3.eu-north-1.amazonaws.com
AWS_S3_ROOT_PREFIX=smc

# LinkedIn OAuth — developer.linkedin.com se app banao
# Production redirect: https://<API_HOST>/api/v1/accounts/linkedin/callback
LINKEDIN_CLIENT_ID=77zeekbsvlfp20
LINKEDIN_CLIENT_SECRET=WPL_AP1.cpUzp9TXb2aOV37u.jwe2FQ==
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/accounts/linkedin/callback
LINKEDIN_API_VERSION=202601

# Meta (Facebook + Instagram) — Facebook Login for Business needs META_CONFIG_ID
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/v1/accounts/facebook/callback
META_CONFIG_ID=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/v1/accounts/instagram/callback

# X (Twitter) OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/api/v1/accounts/twitter/callback

# Reddit OAuth
# Production redirect: https://<API_HOST>/api/v1/accounts/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3001/api/v1/accounts/reddit/callback
REDDIT_USER_AGENT=windows:com.smc.crossposter:v1.0 (by /u/YourRedditUsername)

# Frontend URL (CORS) — production: https://app.your-domain.com
FRONTEND_URL=http://localhost:5173

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin (Score based)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Email (SMTP) — password reset codes
# Gmail example: smtp.gmail.com, port 587, SMTP_SECURE=false, use App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="SMC <your@gmail.com>"


# MiniMax M-series AI — https://platform.minimax.io
# NEVER commit real keys. Rotate if exposed.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_IMAGE_MODEL=image-01
# OpenAI image generation (optional — DALL-E for auto post images)
# Users can also add their own OpenAI key in Settings → AI Keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Scheduler — publishes due scheduled posts (poll interval ms)
SCHEDULER_POLL_INTERVAL_MS=60000

# Stripe billing — https://dashboard.stripe.com
# Create Products + recurring Prices for Medium ($9) and Premium ($19), then paste Price IDs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEDIUM=price_xxx_medium
STRIPE_PRICE_PREMIUM=price_xxx_premium
# Optional — defaults to FRONTEND_URL/settings?billing=success|canceled
# STRIPE_SUCCESS_URL=http://localhost:5173/settings?billing=success
# STRIPE_CANCEL_URL=http://localhost:5173/settings?billing=canceled

# Complimentary Premium — no Stripe required (comma-separated)
PREMIER_MEMBER_EMAILS=haseebcodejourney@gmail.com
PREMIER_MEMBER_HANDLES=hamzahaseeb1996
