generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String
  name                 String?
  avatarUrl            String?
  subscriptionTier     SubscriptionTier    @default(FREE)
  subscriptionStatus   SubscriptionStatus  @default(ACTIVE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  accounts             SocialAccount[]
  posts                Post[]
  media                Media[]
  passwordResetCodes   PasswordResetCode[]
  aiCredentials        UserAiCredential[]
  googleAdsAccounts    GoogleAdsAccount[]
  linkedInAdsAccounts  LinkedInAdsAccount[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model GoogleAdsAccount {
  id               String   @id @default(cuid())
  userId           String
  customerId       String
  customerName     String?
  loginCustomerId  String?
  accessToken      String
  refreshToken     String?
  expiresAt        DateTime?
  scopes           String[]
  metadata         Json?
  isActive         Boolean  @default(true)
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountMetrics   GoogleAdsAccountMetric[]
  campaignMetrics  GoogleAdsCampaignMetric[]

  @@unique([userId, customerId])
  @@index([userId])
}

model GoogleAdsAccountMetric {
  id                 String   @id @default(cuid())
  googleAdsAccountId String
  date               DateTime @db.Date
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  costMicros         BigInt   @default(0)
  conversions        Float    @default(0)
  ctr                Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account GoogleAdsAccount @relation(fields: [googleAdsAccountId], references: [id], onDelete: Cascade)

  @@unique([googleAdsAccountId, date])
  @@index([googleAdsAccountId, date])
}

model GoogleAdsCampaignMetric {
  id                 String   @id @default(cuid())
  googleAdsAccountId String
  campaignId         String
  campaignName       String?
  date               DateTime @db.Date
  impressions        Int      @default(0)
  clicks             Int      @default(0)
  costMicros         BigInt   @default(0)
  conversions        Float    @default(0)
  ctr                Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account GoogleAdsAccount @relation(fields: [googleAdsAccountId], references: [id], onDelete: Cascade)

  @@unique([googleAdsAccountId, campaignId, date])
  @@index([googleAdsAccountId, date])
  @@index([googleAdsAccountId, campaignId])
}

model LinkedInAdsAccount {
  id            String   @id @default(cuid())
  userId        String
  adAccountId   String
  adAccountName String?
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]
  metadata      Json?
  isActive      Boolean  @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountMetrics  LinkedInAdsAccountMetric[]
  campaignMetrics LinkedInAdsCampaignMetric[]

  @@unique([userId, adAccountId])
  @@index([userId])
}

model LinkedInAdsAccountMetric {
  id                  String   @id @default(cuid())
  linkedInAdsAccountId String
  date                DateTime @db.Date
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  costMicros          BigInt   @default(0)
  conversions         Float    @default(0)
  ctr                 Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account LinkedInAdsAccount @relation(fields: [linkedInAdsAccountId], references: [id], onDelete: Cascade)

  @@unique([linkedInAdsAccountId, date])
  @@index([linkedInAdsAccountId, date])
}

model LinkedInAdsCampaignMetric {
  id                   String   @id @default(cuid())
  linkedInAdsAccountId String
  campaignId           String
  campaignName         String?
  date                 DateTime @db.Date
  impressions          Int      @default(0)
  clicks               Int      @default(0)
  costMicros           BigInt   @default(0)
  conversions          Float    @default(0)
  ctr                  Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account LinkedInAdsAccount @relation(fields: [linkedInAdsAccountId], references: [id], onDelete: Cascade)

  @@unique([linkedInAdsAccountId, campaignId, date])
  @@index([linkedInAdsAccountId, date])
  @@index([linkedInAdsAccountId, campaignId])
}

model UserAiCredential {
  id        String     @id @default(cuid())
  userId    String
  name      String
  provider  AiProvider
  apiKeyEnc String
  baseUrl   String?
  model     String?
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     Platform
  accountId    String
  accountName  String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]
  metadata     Json?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postTargets  PostTarget[]
  publishLogs  PublishLog[]

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  content      String
  title        String?
  images       String[]
  hashtagMode  HashtagMode  @default(AUTO)
  hashtags     String[]
  language     String       @default("en")
  scheduledFor DateTime?
  publishedAt  DateTime?
  status       PostStatus   @default(DRAFT)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets      PostTarget[]
  publishLogs  PublishLog[]

  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([scheduledFor])
}

model PostTarget {
  id              String        @id @default(cuid())
  postId          String
  socialAccountId String
  platform        Platform
  customContent   String?
  subreddit       String?
  status          PublishStatus @default(PENDING)
  platformPostId  String?
  errorMessage    String?
  publishedAt     DateTime?

  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@unique([postId, socialAccountId])
}

model PublishLog {
  id              String   @id @default(cuid())
  postId          String
  socialAccountId String
  action          String
  status          String
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime @default(now())

  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
}

model Media {
  id        String   @id @default(cuid())
  userId    String
  s3Key     String   @unique
  s3Url     String
  fileName  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HashtagMode {
  MANUAL
  AUTO
  NONE
}

enum Platform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TWITTER
  REDDIT
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIAL
}

enum PublishStatus {
  PENDING
  PUBLISHING
  SUCCESS
  FAILED
  SKIPPED
}

enum AiProvider {
  MINIMAX
  OPENAI
  ANTHROPIC
  CUSTOM
}

enum SubscriptionTier {
  FREE
  MEDIUM
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}
