# Local dev: Vite proxy forwards /api → localhost:3001 (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Production (Vercel build env): full backend URL, no trailing slash on host
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1

# Google reCAPTCHA v3 site key (pair with backend RECAPTCHA_SECRET_KEY)
# Register your production domain in https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
