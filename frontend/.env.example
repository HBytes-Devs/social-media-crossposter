# Local dev: Vite proxy forwards /api → localhost:3001 (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# GitHub Pages / production: full backend URL (set in GitHub repo Variables for CI)
# VITE_API_BASE_URL=https://smc-api.onrender.com/api/v1

# Subpath when hosting on GitHub Pages (repo name). CI sets this automatically.
# VITE_BASE_PATH=/social-media-crossposter/

# Google reCAPTCHA v3 site key (pair with backend RECAPTCHA_SECRET_KEY)
# Register your production domain in https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
