NODE_ENV=production
PORT=3001

# Public URLs (IP-first deploy on Contabo)
API_BASE_URL=http://169.58.63.125
FRONTEND_URL=http://169.58.63.125

# Internal service URLs (Docker network)
POSTGRES_USER=smc
POSTGRES_PASSWORD=change-this-to-a-strong-db-password
POSTGRES_DB=smc_db
DATABASE_URL=postgresql://smc:change-this-to-a-strong-db-password@postgres:5432/smc_db
REDIS_URL=redis://redis:6379

# JWT / Auth
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
TOKEN_ENCRYPTION_KEY=change-this-to-a-long-random-encryption-key

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_S3_ROOT_PREFIX=smc

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://169.58.63.125/api/v1/accounts/linkedin/callback
LINKEDIN_API_VERSION=202601

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://169.58.63.125/api/v1/accounts/facebook/callback
META_CONFIG_ID=
META_INSTAGRAM_REDIRECT_URI=http://169.58.63.125/api/v1/accounts/instagram/callback
META_ADS_REDIRECT_URI=http://169.58.63.125/api/v1/meta-ads/callback
META_ADS_CONFIG_ID=

# X / Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://169.58.63.125/api/v1/accounts/twitter/callback

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://169.58.63.125/api/v1/accounts/reddit/callback
REDDIT_USER_AGENT=

# reCAPTCHA
# Google reCAPTCHA v3 — leave EMPTY on Contabo IP until site key is baked into frontend build
# and 169.58.63.125 is added in Google reCAPTCHA admin domains.
RECAPTCHA_SECRET_KEY=
# Optional: only needed if you enable reCAPTCHA (must match Google site key)
VITE_RECAPTCHA_SITE_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Scheduler
SCHEDULER_POLL_INTERVAL_MS=60000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_PREMIUM=
STRIPE_SUCCESS_URL=http://169.58.63.125/settings?billing=success
STRIPE_CANCEL_URL=http://169.58.63.125/settings?billing=canceled

# Premium flags
PREMIER_MEMBER_EMAILS=
PREMIER_MEMBER_HANDLES=
SUPER_ADMIN_EMAILS=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://169.58.63.125/api/v1/google-ads/callback

# LinkedIn Ads
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
LINKEDIN_ADS_REDIRECT_URI=http://169.58.63.125/api/v1/linkedin-ads/callback

# Sentry
SENTRY_DSN=
